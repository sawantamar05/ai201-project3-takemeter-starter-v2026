# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Hugging Face model cache — big, and rebuildable
.cache/
models/

# The notebook's training output directory. Checkpoints are hundreds of MB and
# they are not evidence of anything — results.json is. Without this line a
# `git add -A` could stage a model checkpoint for a later commit.
takemeter_out/

# OS noise
.DS_Store
Thumbs.db

# NOTE: results.json, test_split.csv, results_three_seeds_*.json,
# baseline_results.json, and agreement_results.json are deliberately NOT
# ignored. They record the runs and are graded. Commit them manually.
